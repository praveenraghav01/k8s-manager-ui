<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron's V8 JIT compiles to executable memory at runtime. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- We ship an unpacked native .node addon and fork a Node utility
       process; both are signed with a different (ad-hoc) authority than the
       Electron framework, so library validation must be relaxed. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- The main process repairs PATH via env vars before spawning kubectl. -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
</dict>
</plist>
