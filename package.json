{
  "name": "k8s-manager-ui",
  "version": "1.2.1",
  "description": "Kubernetes resource manager UI",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server.js",
    "client": "cd client && npm run dev",
    "version:sync": "node scripts/sync-version.mjs",
    "build": "npm run version:sync && cd client && npm run build",
    "start": "node server.js",
    "app": "electron .",
    "app:pack": "npm run build && electron-builder --dir --mac",
    "app:dist": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@kubernetes/client-node": "^0.20.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "js-yaml": "^4.1.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "electron": "^31.7.0",
    "electron-builder": "^25.1.8"
  },
  "comment:overrides": "Force patched transitive deps of @kubernetes/client-node (CVE fixes). Scoped to that subtree so the Electron/dev toolchain keeps its own versions.",
  "overrides": {
    "@kubernetes/client-node": {
      "form-data": "^2.5.6",
      "jsonpath-plus": "^10.3.0",
      "tar": "^7.5.19"
    }
  },
  "build": {
    "appId": "com.k8smanager.desktop",
    "productName": "Kubernetes Manager",
    "asar": false,
    "afterPack": "electron/after-pack.cjs",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "server.js",
      "assistant.js",
      "package.json",
      "client/dist/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "category": "Development",
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    }
  }
}
