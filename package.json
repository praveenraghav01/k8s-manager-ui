{
  "name": "k8s-manager-ui",
  "version": "1.4.3",
  "description": "Kubernetes resource manager UI",
  "author": {
    "name": "Praveen Kumar",
    "email": "praveensinghraghav96@gmail.com"
  },
  "license": "MIT",
  "desktopName": "k8sight",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server.js",
    "client": "cd client && npm run dev",
    "version:sync": "node scripts/sync-version.mjs",
    "build": "node scripts/write-gke-oauth.mjs && npm run version:sync && cd client && npm run build",
    "start": "node server.js",
    "app": "electron .",
    "app:pack": "npm run build && electron-builder --dir --mac",
    "app:dist": "npm run build && electron-builder --mac",
    "dist": "npm run build && electron-builder --publish never",
    "mcp": "node mcp-stdio.js"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-ec2": "^3.1127.0",
    "@aws-sdk/client-eks": "^3.1127.0",
    "@aws-sdk/client-sso": "^3.1127.0",
    "@aws-sdk/client-sso-oidc": "^3.1127.0",
    "@aws-sdk/client-sts": "^3.1127.0",
    "@aws-sdk/credential-providers": "^3.1127.0",
    "@aws-sdk/signature-v4": "^3.370.0",
    "@kubernetes/client-node": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/shared-ini-file-loader": "^4.7.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "js-yaml": "^4.1.0",
    "node-pty": "^1.1.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.k8sight.desktop",
    "productName": "k8sight",
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "afterPack": "electron/after-pack.cjs",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "*.js",
      "gke-oauth.json",
      "package.json",
      "client/dist/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "artifactName": "${productName}-macos.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "format": "ULFO"
    },
    "linux": {
      "category": "Development",
      "icon": "build/icon.png",
      "synopsis": "A desktop UI for browsing and operating Kubernetes clusters",
      "syncDesktopName": true,
      "artifactName": "${productName}-linux.${ext}",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "artifactName": "${productName}-windows.${ext}",
      "target": [
        "nsis"
      ]
    }
  }
}
